{
  "name": "digital-business-card-api",
  "version": "1.0.0",
  "private": true,
  "description": "Nikita Makeev's read-only GraphQL business card",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "npm run build && node --watch dist/src/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed.js",
    "db:prepare": "npm run db:migrate && npm run db:seed",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:e2e": "node scripts/test-e2e.cjs"
  },
  "dependencies": {
    "@apollo/server": "5.5.2",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.2.1",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/graphql": "14.2.1",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dataloader": "2.2.3",
    "dotenv": "18.0.10",
    "graphql": "16.15.0",
    "joi": "18.3.2",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "12.5.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
